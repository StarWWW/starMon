<Window x:Class="StarMon.Ui.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="StarMon"
        Width="1000" Height="760"
        MinWidth="640" MinHeight="480"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Plane}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal">

    <!-- The window draws its own title bar, so the system's is removed and a
         caption area is nominated instead. Doing it through WindowChrome
         rather than WindowStyle="None" alone is what keeps snapping, the
         Aero shake, the system menu on right-click and the resize borders
         working — all of which a hand-rolled frame otherwise loses, and none
         of which anybody notices until they are gone.

         AllowsTransparency stays off: turning it on puts the window into a
         layered mode that disables the DWM backdrop, and the Mica the shell
         asks for at startup would silently never appear. -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="40"
                            ResizeBorderThickness="6"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <!-- The interface is drawn at a fixed 1000x760, and scaled to whatever
         the window actually is.

         Those are device-independent units, so the physical size follows the
         display scale: at 150 % - an ordinary accessibility setting - the
         window wanted 1500x1140 physical pixels, and a 1920x1080 desktop has
         about 1040 of vertical room. A hundred pixels of the interface were
         off the bottom of the screen with no way to reach them, because the
         window was also pinned to exactly that size in both directions and
         set to CanMinimize. The same happened on any 1366x768 panel, which
         entry-level machines in this family still ship with.

         Scaling rather than reflowing is deliberate. Every page here is laid
         out at a known size, with sized cards and a star-sized content row;
         putting that in a scroll viewer collapses the star row, and reflowing
         it properly is a redesign of eight pages. A uniform scale keeps the
         layout exactly as drawn and makes it fit anywhere.

         DownOnly, so a large display gets the interface at its intended size
         rather than a magnified one. The window is resizable now, so anybody
         who wants it smaller can have it smaller. -->
    <Viewbox Stretch="Uniform" StretchDirection="DownOnly"
             HorizontalAlignment="Center" VerticalAlignment="Center">

        <!-- The shell is put in from the code-behind: markup here cannot name
             a type from this assembly. See the note in Ui/Views/Cards.xaml. -->
        <ContentControl x:Name="ShellHost" Width="1000" Height="760"/>

    </Viewbox>

</Window>
