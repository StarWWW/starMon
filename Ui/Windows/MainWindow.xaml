<Window x:Class="StarMon.Ui.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="StarMon"
        Width="1000" Height="760"
        MinWidth="640" MinHeight="480"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Plane}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal">

    <!-- The window draws its own title bar, so the system's is removed and a
         caption area is nominated instead. Doing it through WindowChrome
         rather than WindowStyle="None" alone is what keeps snapping, the
         Aero shake, the system menu on right-click and the resize borders
         working — all of which a hand-rolled frame otherwise loses, and none
         of which anybody notices until they are gone.

         AllowsTransparency stays off: it puts the window into a layered mode
         that costs every frame a copy through system memory, for a window
         that paints every pixel of itself anyway. -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="40"
                            ResizeBorderThickness="6"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <!-- The interface is laid out for 1000x760 and never smaller: below that
         it is scaled down as a whole, and above it the pages are given the
         room.

         It used to be drawn at exactly 1000x760 and scaled down only, so a
         window made larger — or maximised on a 1440p display — showed the
         same 1000x760 island in the middle of a sea of empty plane, and the
         chart, the curve and the log never got a pixel more to work with.
         Now the shell is sized to the window, in the window's own units,
         divided by whatever scale is needed to keep it at least the design
         size in both directions; the Viewbox then shrinks it back by that
         same scale. The result fills the window exactly, at any size, and a
         small window still sees the whole interface rather than a clipped
         corner of it. See FitShell in the code-behind.

         Frame is the element the maximised-window inset is applied to: a
         maximised WindowChrome window hangs off every edge of the monitor by
         its resize border, and without it the title bar's buttons and the
         pages' outer edges are cut off. -->
    <Border x:Name="Frame" Background="{DynamicResource Plane}">
        <Grid x:Name="Client">
            <Viewbox Stretch="Uniform" StretchDirection="DownOnly"
                     HorizontalAlignment="Center" VerticalAlignment="Center">

                <!-- The shell is put in from the code-behind, and sized there -->
                <ContentControl x:Name="ShellHost" Width="1000" Height="760"/>

            </Viewbox>
        </Grid>
    </Border>

</Window>
