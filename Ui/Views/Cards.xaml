<!-- StarMon: hardware monitoring and control
     Portions copyright © 2023-2024 Piotr Szczepański (GPL-3.0)

     The templates that draw the view models. Kept apart from Ui/Theme, which
     knows only about controls and colours: this is the first file that knows
     what a reading is.

     The converters these templates use are registered from code, in
     Ui/Shell/Theme.cs, under the keys used below, and the drawn controls are
     placed into ContentControls from each view's code-behind.

     That began as a build constraint: markup naming a type from this same
     assembly forces a second markup-compilation pass, which could not run
     while StarMon.resx existed. The resx is gone and the {loc:Str} extension
     now names a local type in every view, so the constraint no longer holds;
     the pattern is kept because it works and changing it buys nothing. The
     earlier cards this file held — a lead card, stat cards, a fan card with a
     blade that turned whether or not the fans did — went with the old
     dashboard, and were removed once nothing used them. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:loc="clr-namespace:StarMon.Ui.Loc">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Ui/Theme/Theme.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!-- A legend entry, which is also the control that hides its series.
         A ToggleButton because that is what it is: pressing it turns
         something off and it stays off, and getting that for free brings
         keyboard focus and the accessibility tree with it.

         The chip carries the identity; the text never wears the series
         colour. Coloured text at this size is harder to read, and it invites
         reading the colour as though it meant something about the value. A
         hidden series shows a hollow ring rather than a filled dot, so the
         state survives being seen in greyscale. -->
    <DataTemplate x:Key="LegendEntry">
        <ToggleButton IsChecked="{Binding IsVisible}" Cursor="Hand"
                      Margin="0,0,14,0" FocusVisualStyle="{x:Null}"
                      ToolTip="{loc:Str GuiWpfTipLegend}">
            <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Grid Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,6,0">
                            <Ellipse x:Name="Ring" StrokeThickness="1.2"
                                     Stroke="{StaticResource TextMuted}"/>
                            <Ellipse x:Name="Dot"
                                     Fill="{Binding Slot, Converter={StaticResource SlotBrush}}"/>
                        </Grid>
                        <TextBlock x:Name="Label" Text="{Binding Label}"
                                   Style="{StaticResource Micro}"
                                   Foreground="{StaticResource TextSecondary}"
                                   VerticalAlignment="Center"/>
                        <TextBlock x:Name="Value" Text="{Binding Value}"
                                   Style="{StaticResource Readout}"
                                   FontSize="{StaticResource SizeMicro}"
                                   Margin="5,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="False">
                            <Setter TargetName="Dot" Property="Opacity" Value="0"/>
                            <Setter TargetName="Label" Property="Foreground"
                                    Value="{StaticResource TextMuted}"/>
                            <Setter TargetName="Value" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Ring" Property="Opacity" Value="0"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Label" Property="Foreground"
                                    Value="{StaticResource TextPrimary}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </ToggleButton.Template>
        </ToggleButton>
    </DataTemplate>

</ResourceDictionary>
