<UserControl x:Class="StarMon.Ui.Views.SystemView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:StarMon.Ui.Loc">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Ui/Views/Cards.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <DataTemplate x:Key="Capability">
                <Grid Height="19" ToolTip="{Binding Detail}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- A filled dot for supported, a hollow ring for not, so
                         the answer survives being seen in greyscale and does
                         not rest on colour alone -->
                    <Grid Grid.Column="0" Width="8" Height="8"
                          HorizontalAlignment="Left" VerticalAlignment="Center">
                        <Ellipse Fill="{Binding Health, Converter={StaticResource HealthBrush}}"
                                 Visibility="{Binding IsSupported,
                                              Converter={StaticResource ShowWhen}}"/>
                        <Ellipse Stroke="{StaticResource TextMuted}" StrokeThickness="1.2"/>
                    </Grid>

                    <TextBlock Grid.Column="1" Text="{Binding Caption}"
                               Style="{StaticResource RowName}"
                               VerticalAlignment="Center"/>

                    <TextBlock Grid.Column="2" Text="{Binding Detail}"
                               Style="{StaticResource Micro}"
                               VerticalAlignment="Center" Margin="10,0,0,0"
                               TextTrimming="CharacterEllipsis"/>

                </Grid>
            </DataTemplate>

            <DataTemplate x:Key="PlainRow">
                <Grid Height="19" ToolTip="{Binding Tip}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding Name}"
                               Style="{StaticResource RowName}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{Binding Value}"
                               Style="{StaticResource Readout}"
                               FontSize="{StaticResource SizeLabel}"
                               TextAlignment="Right" TextTrimming="CharacterEllipsis"
                               Margin="12,0,0,0" VerticalAlignment="Center"/>
                </Grid>
            </DataTemplate>

        </ResourceDictionary>
    </UserControl.Resources>

    <!-- What this machine actually is, and what it will admit to.
         Three of the four cards here show things the application has always
         known and never said: the board profile it works out at every start,
         the BIOS setup menu it reads and caches, and the full hardware report
         it can generate and had no caller for. -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="18,14,18,14">
        <!-- Two flowing columns rather than a grid of aligned rows.
             A grid made every row as tall as the tallest card in it, so the
             short cards on the left sat above four hundred pixels of nothing
             while the capability list on the right ran on. Columns that simply
             stack have no such gap. -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>  <!-- machine · profile | support · power -->
                <RowDefinition Height="Auto"/>  <!-- BIOS setup                          -->
                <RowDefinition Height="Auto"/>  <!-- the full report                     -->
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.25*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Row="0" Grid.Column="0">

                <!-- The machine -->
                <Border Style="{StaticResource CardSurface}">
                    <StackPanel Margin="14,11,14,12">
                        <TextBlock Text="{loc:Str GuiWpfMachineCaption}"
                                   Style="{StaticResource Caption}" Margin="0,0,0,7"/>
                        <Border Style="{StaticResource Rule}" Margin="0,0,0,5"/>
                        <ItemsControl ItemsSource="{Binding Facts}"
                                      ItemTemplate="{StaticResource PlainRow}"/>
                    </StackPanel>
                </Border>

                <!-- What the application worked out about the board -->
                <Border Style="{StaticResource CardSurface}" Margin="0,10,0,0">
                    <StackPanel Margin="14,11,14,12">
                        <TextBlock Text="{Binding Profile.Caption}"
                                   Style="{StaticResource Caption}" Margin="0,0,0,7"/>
                        <Border Style="{StaticResource Rule}" Margin="0,0,0,5"/>
                        <ItemsControl ItemsSource="{Binding Profile.Rows}"
                                      ItemTemplate="{StaticResource PlainRow}"/>
                    </StackPanel>
                </Border>

            </StackPanel>

            <!-- Capabilities, and the Windows power mode under them.
                 Spans both rows so it is free to be taller or shorter than the
                 cards beside it without either one being padded out to match. -->
            <StackPanel Grid.Row="0" Grid.RowSpan="2" Grid.Column="2">

                <Border Style="{StaticResource CardSurface}">
                    <StackPanel Margin="14,11,14,12">
                        <DockPanel Margin="0,0,0,7">
                            <TextBlock DockPanel.Dock="Left"
                                       Text="{loc:Str GuiWpfSupportCaption}"
                                       Style="{StaticResource Caption}"/>
                            <TextBlock Style="{StaticResource Micro}" TextAlignment="Right"
                                       Text="{loc:Str GuiWpfProbing}"
                                       Visibility="{Binding IsProbing,
                                                    Converter={StaticResource ShowWhen}}"/>
                        </DockPanel>
                        <Border Style="{StaticResource Rule}" Margin="0,0,0,5"/>
                        <ItemsControl ItemsSource="{Binding Capabilities}"
                                      ItemTemplate="{StaticResource Capability}"/>
                    </StackPanel>
                </Border>

                <!-- Windows' own power mode. The application has been able to
                     read and set this since SystemMetrics was written, the
                     capability probe advertises it as supported, and there was
                     no control for it anywhere. -->
                <Border Style="{StaticResource CardSurface}" Margin="0,10,0,0">
                    <StackPanel Margin="14,11,14,12">
                        <TextBlock Text="{loc:Str GuiWpfPowerModeCaption}"
                                   Style="{StaticResource Caption}" Margin="0,0,0,4"/>
                        <TextBlock Style="{StaticResource Micro}" TextWrapping="Wrap"
                                   Margin="0,0,0,9"
                                   Text="{loc:Str GuiWpfPowerModeHint}"/>
                        <Border Style="{StaticResource SegmentGroup}" HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal">
                                <ToggleButton Content="{loc:Str GuiWpfPowerModeSaver}"
                                              Style="{StaticResource Segment}"
                                              IsChecked="{Binding IsPowerSaver}" ToolTip="{loc:Str GuiWpfTipPowerModeSaver}"/>
                                <ToggleButton Content="{loc:Str GuiWpfPowerModeBalanced}"
                                              Style="{StaticResource Segment}"
                                              IsChecked="{Binding IsPowerBalanced}" ToolTip="{loc:Str GuiWpfTipPowerModeBalanced}"/>
                                <ToggleButton Content="{loc:Str GuiWpfPowerModeHigh}"
                                              Style="{StaticResource Segment}"
                                              IsChecked="{Binding IsPowerHigh}" ToolTip="{loc:Str GuiWpfTipPowerModeHigh}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

            </StackPanel>

            <!-- The BIOS setup menu, in the left column under the machine
                 facts so it fills the room they leave. In the grid it sits in
                 the same cell as the column above it, which a StackPanel would
                 not allow — so it is its own row, and the column above is
                 sized by its content rather than stretched. -->
            <Border Grid.Row="1" Grid.Column="0"
                    Style="{StaticResource CardSurface}" Margin="0,10,0,0">
                <Grid Margin="14,11,14,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="236"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,8">
                        <TextBlock DockPanel.Dock="Left" Text="{loc:Str GuiWpfBiosCaption}"
                                   Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding SettingsSummary}"
                                   Style="{StaticResource Readout}"
                                   FontSize="{StaticResource SizeMicro}"
                                   VerticalAlignment="Center" Margin="12,0,0,0"/>
                        <!-- A fixed width, not a maximum with a left
                             alignment: an empty text box asked to size to its
                             content sizes to nothing, and the search field
                             came out as a blank stub -->
                        <Grid HorizontalAlignment="Left" Width="240" Margin="16,0,0,0">
                            <TextBox x:Name="SearchBox" Style="{StaticResource Field}"
                                     Padding="8,4"
                                     Text="{Binding Search, UpdateSourceTrigger=PropertyChanged, Delay=180}"
                                     ToolTip="{loc:Str GuiWpfBiosSearchTip}"/>
                            <TextBlock Text="{loc:Str GuiWpfSearch}"
                                       Margin="10,0,0,0" VerticalAlignment="Center"
                                       IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Micro}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=SearchBox}"
                                                         Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </DockPanel>

                    <TextBlock Grid.Row="1" Style="{StaticResource Micro}"
                               TextWrapping="Wrap" Margin="0,0,0,8"
                               Text="{loc:Str GuiWpfBiosHint}"/>

                    <Border Grid.Row="2" Style="{StaticResource InsetSurface}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="10,7,6,7">
                            <ItemsControl ItemsSource="{Binding BiosSettings}"
                                          ItemTemplate="{StaticResource PlainRow}"/>
                        </ScrollViewer>
                    </Border>

                </Grid>
            </Border>

            <!-- The full report.
                 Full width along the bottom rather than squeezed into a third
                 of one: it is two hundred lines of fixed-pitch text, and in a
                 narrow column every one of them wrapped. Two columns of it fit
                 the whole report on screen without scrolling, which is what it
                 is for — reading it, and sending it. -->
            <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3"
                    Style="{StaticResource CardSurface}" Margin="0,10,0,0">
                <Grid Margin="14,11,14,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="352"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,8">
                        <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}"
                                Content="{loc:Str GuiWpfCopy}" MinWidth="0" Padding="12,5"
                                Command="{Binding CopyReportCommand}"
                                Margin="12,0,0,0" ToolTip="{loc:Str GuiWpfTipCopyReport}"/>
                        <TextBlock DockPanel.Dock="Left" Text="{loc:Str GuiWpfReportCaption}"
                                   Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                        <TextBlock Style="{StaticResource Micro}" Margin="16,0,0,0"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                   Text="{loc:Str GuiWpfReportHint}"/>
                    </DockPanel>

                    <Border Grid.Row="1" Style="{StaticResource InsetSurface}">
                        <!-- Selectable rather than a label: the point of this
                             report is that it can be sent to somebody.
                             Laid out in columns so the whole of it is on
                             screen at once. -->
                        <FlowDocumentScrollViewer x:Name="ReportHost"
                                                  VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled"
                                                  IsSelectionEnabled="True"
                                                  Foreground="{StaticResource TextSecondary}"
                                                  Margin="4,2,2,2"/>
                    </Border>

                </Grid>
            </Border>

        </Grid>
    </ScrollViewer>
</UserControl>
