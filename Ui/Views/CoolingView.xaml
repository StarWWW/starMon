<UserControl x:Class="StarMon.Ui.Views.CoolingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:StarMon.Ui.Loc">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Ui/Views/Cards.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- One saved program. The running one carries a dot, so the list
                 says which is in force rather than only which is selected —
                 they are different questions and used to have one answer. -->
            <Style x:Key="ProgramRow" TargetType="ListBoxItem">
                <Setter Property="Padding" Value="10,6"/>
                <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="Back" Background="Transparent"
                                    CornerRadius="{StaticResource RadiusInset}"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Back" Property="Background"
                                            Value="{StaticResource Hover}"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Back" Property="Background"
                                            Value="{StaticResource AccentFaint}"/>
                                    <Setter Property="Foreground"
                                            Value="{StaticResource TextPrimary}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <DataTemplate x:Key="ProgramEntry">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Ellipse Grid.Column="0" Width="6" Height="6"
                             HorizontalAlignment="Left" VerticalAlignment="Center"
                             Fill="{StaticResource Accent}"
                             Visibility="{Binding IsRunning,
                                          Converter={StaticResource ShowWhen}, ConverterParameter=Hidden}"/>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding Name}" Style="{StaticResource Body}"
                                   Foreground="{StaticResource TextPrimary}"/>
                        <TextBlock Text="{Binding Detail}" Style="{StaticResource Micro}"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Grid>
            </DataTemplate>

            <DataTemplate x:Key="StateRow">
                <Grid Height="20" ToolTip="{Binding Tip}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding Name}"
                               Style="{StaticResource RowName}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{Binding Value}"
                               Style="{StaticResource Readout}"
                               FontSize="{StaticResource SizeLabel}"
                               TextAlignment="Right" TextTrimming="CharacterEllipsis"
                               Margin="12,0,0,0" VerticalAlignment="Center"/>
                </Grid>
            </DataTemplate>

        </ResourceDictionary>
    </UserControl.Resources>

    <!-- Everything about how the machine cools itself, on one page: the curve
         to draw, the programs to keep, and what the firmware will actually
         allow. The three used to be a curve editor, a tray menu and a log
         line respectively. -->
    <Grid Margin="18,14,18,14">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="312"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- The curve -->
        <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource CardSurface}">
            <Grid Margin="14,11,14,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- The caption is docked, the hint fills. The other way round
                     the hint claims its full desired width first — and it is a
                     sentence — leaving the caption nothing at all. -->
                <DockPanel Grid.Row="0" Margin="0,0,0,9">
                    <TextBlock DockPanel.Dock="Left" Text="{loc:Str GuiWpfCurveCaption}"
                               Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                    <TextBlock Style="{StaticResource Micro}"
                               Text="{loc:Str GuiWpfCurveHint}"
                               TextTrimming="CharacterEllipsis"
                               TextAlignment="Right"
                               VerticalAlignment="Center" Margin="16,0,0,0"/>
                </DockPanel>

                <!-- The editor is placed into EditorHost from the code-behind:
                     markup here cannot name a type from this assembly, for the
                     reason set out at the top of Ui/Views/Cards.xaml -->
                <Border Grid.Row="1" Style="{StaticResource InsetSurface}">
                    <ContentControl x:Name="EditorHost" Margin="4"/>
                </Border>

                <DockPanel Grid.Row="2" Margin="0,12,0,0">

                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                        <Button Content="{loc:Str GuiWpfReset}" Style="{StaticResource GhostButton}"
                                Command="{Binding Curve.ResetCommand}" Margin="0,0,9,0" ToolTip="{loc:Str GuiWpfTipCurveReset}"/>
                        <Button Content="{loc:Str GuiWpfStop}" Style="{StaticResource DangerButton}"
                                Command="{Binding Curve.StopCommand}" Margin="0,0,9,0"
                                IsEnabled="{Binding Curve.IsRunning}" ToolTip="{loc:Str GuiWpfTipCurveStop}"/>
                        <Button Content="{loc:Str GuiWpfApply}" Style="{StaticResource PrimaryButton}"
                                Command="{Binding Curve.ApplyCommand}" ToolTip="{loc:Str GuiWpfTipCurveApply}"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="6" Height="6" VerticalAlignment="Center" Margin="2,0,9,0"
                                 Fill="{StaticResource Accent}"
                                 Visibility="{Binding Curve.IsRunning,
                                              Converter={StaticResource ShowWhen}, ConverterParameter=Hidden}"/>
                        <TextBlock Text="{Binding Curve.Status}" Style="{StaticResource Body}"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                </DockPanel>

            </Grid>
        </Border>

        <!-- The programs. This is what the Program button on the dashboard
             had nothing behind it: a way to pick which one. -->
        <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource CardSurface}">
            <Grid Margin="14,11,14,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="{loc:Str GuiWpfPrograms}"
                           Style="{StaticResource Caption}" Margin="0,0,0,8"/>

                <Border Grid.Row="1" Style="{StaticResource InsetSurface}">
                    <ListBox ItemsSource="{Binding Programs}"
                             SelectedItem="{Binding Selected}"
                             ItemTemplate="{StaticResource ProgramEntry}"
                             ItemContainerStyle="{StaticResource ProgramRow}" ToolTip="{loc:Str GuiWpfTipProgramList}"
                             Background="Transparent" BorderThickness="0"
                             Margin="3"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
                </Border>

                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
                    <Button Content="{loc:Str GuiWpfRun}" Style="{StaticResource PrimaryButton}"
                            MinWidth="0" Padding="14,7" Margin="0,0,8,0"
                            Command="{Binding RunCommand}"
                            ToolTip="{loc:Str GuiWpfTipRun}"/>
                    <Button Content="{loc:Str GuiWpfStop}" Style="{StaticResource GhostButton}"
                            MinWidth="0" Padding="14,7" Margin="0,0,8,0"
                            Command="{Binding StopCommand}" ToolTip="{loc:Str GuiWpfTipProgramStop}"/>
                    <Button Content="{loc:Str GuiWpfDelete}" Style="{StaticResource DangerButton}"
                            MinWidth="0" Padding="14,7"
                            Command="{Binding DeleteCommand}"
                            ToolTip="{loc:Str GuiWpfTipDelete}"/>
                </StackPanel>

                <!-- Saving the drawn curve under a name of its own. Without
                     this the editor could only ever overwrite one program,
                     called Curve, which is why nobody had more than one. -->
                <DockPanel Grid.Row="3" Margin="0,10,0,0">
                    <Button DockPanel.Dock="Right" Content="{loc:Str GuiWpfSave}"
                            Style="{StaticResource GhostButton}"
                            MinWidth="0" Padding="14,7" Margin="8,0,0,0"
                            Command="{Binding SaveCommand}"
                            ToolTip="{loc:Str GuiWpfTipSave}"/>
                    <TextBox Style="{StaticResource Field}"
                             Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}"
                             MaxLength="32" ToolTip="{loc:Str GuiWpfTipProgramName}"/>
                </DockPanel>

            </Grid>
        </Border>

        <!-- What the machine will let the application do -->
        <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
                Style="{StaticResource CardSurface}" Margin="0,12,0,0">
            <Grid Margin="14,11,14,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="{Binding State.Caption}"
                           Style="{StaticResource Caption}" Margin="0,0,0,7"/>

                <ItemsControl Grid.Row="1" ItemsSource="{Binding State.Rows}"
                              ItemTemplate="{StaticResource StateRow}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="4"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Margin" Value="0,0,20,0"/>
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                </ItemsControl>

            </Grid>
        </Border>

    </Grid>
</UserControl>
