<!-- Every control in the theme, on one sheet, so the design system can be
     looked at as a system rather than one control at a time. Rendered with

         StarMonTest.exe -RenderUi gallery gallery.png

     See Ui/Design/DesignRender.cs for why the interface is looked at this way
     rather than by starting the application. -->
<UserControl x:Class="StarMon.Ui.Design.Gallery"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="920" Height="1270"
             Background="{StaticResource Plane}">
    <!-- The theme is merged into Application.Resources by the host, not here:
         attributes on this root element (Background) are evaluated before
         UserControl.Resources exists, so a dictionary merged locally is too
         late for them. This is also how the application itself will do it. -->
    <UserControl.Resources>
        <ResourceDictionary>
        <Style x:Key="Sec" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <Style x:Key="Row" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal"/>
        </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="28">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="28"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left column -->
        <StackPanel Grid.Column="0">

            <TextBlock Text="STARMON  ·  COMPONENT GALLERY" Style="{StaticResource Caption}"
                       FontSize="13" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,20"/>

            <TextBlock Text="S T A T   C A R D S" Style="{StaticResource Sec}"/>
            <UniformGrid Columns="2" Rows="1" Margin="0,0,0,24">
                <Border Style="{StaticResource CardSurface}" Height="104" Margin="0,0,6,0">
                    <StackPanel Margin="14,11">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="14" Height="2" Background="{StaticResource Warning}"
                                    VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="CPU" Style="{StaticResource Caption}"/>
                        </StackPanel>
                        <TextBlock Text="68 °C" Style="{StaticResource Hero}"
                                   Foreground="{StaticResource Warning}" Margin="0,4,0,0"/>
                        <TextBlock Text="3.9 GHz · 42 W" Style="{StaticResource Body}"
                                   FontSize="{StaticResource SizeLabel}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardSurface}" Height="104" Margin="6,0,0,0">
                    <StackPanel Margin="14,11">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="14" Height="2" Background="{StaticResource Good}"
                                    VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="GPU" Style="{StaticResource Caption}"/>
                        </StackPanel>
                        <TextBlock Text="51 °C" Style="{StaticResource Hero}"
                                   Foreground="{StaticResource Good}" Margin="0,4,0,0"/>
                        <TextBlock Text="1815 MHz · 28 W" Style="{StaticResource Body}"
                                   FontSize="{StaticResource SizeLabel}"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <TextBlock Text="B U T T O N S" Style="{StaticResource Sec}"/>
            <StackPanel Style="{StaticResource Row}" Margin="0,0,0,10">
                <Button Content="Apply" Style="{StaticResource PrimaryButton}" Margin="0,0,10,0"/>
                <Button Content="Default" Style="{StaticResource GhostButton}" Margin="0,0,10,0"/>
                <Button Content="Stop" Style="{StaticResource DangerButton}"/>
            </StackPanel>
            <StackPanel Style="{StaticResource Row}" Margin="0,0,0,24">
                <Button Content="Disabled" Style="{StaticResource GhostButton}"
                        IsEnabled="False" Margin="0,0,10,0"/>
                <Button Content="&#xE711;" Style="{StaticResource IconButton}"
                        FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12"/>
            </StackPanel>

            <TextBlock Text="S E G M E N T E D   S E L E C T I O N" Style="{StaticResource Sec}"/>
            <Border Style="{StaticResource SegmentGroup}" HorizontalAlignment="Left" Margin="0,0,0,24">
                <StackPanel Orientation="Horizontal">
                    <ToggleButton Content="Default" Style="{StaticResource Segment}"/>
                    <ToggleButton Content="Performance" Style="{StaticResource Segment}" IsChecked="True"/>
                    <ToggleButton Content="Cool" Style="{StaticResource Segment}"/>
                    <ToggleButton Content="Manual" Style="{StaticResource Segment}"/>
                </StackPanel>
            </Border>

            <TextBlock Text="S L I D E R S" Style="{StaticResource Sec}"/>
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="86"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="52"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="CPU FAN" Style="{StaticResource Caption}"
                           VerticalAlignment="Center"/>
                <Slider Grid.Column="1" Style="{StaticResource Track}"
                        Minimum="0" Maximum="56" Value="34"/>
                <TextBlock Grid.Column="2" Text="3400" Style="{StaticResource Readout}"
                           HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="86"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="52"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="GPU FAN" Style="{StaticResource Caption}"
                           VerticalAlignment="Center"/>
                <Slider Grid.Column="1" Style="{StaticResource Track}"
                        Minimum="0" Maximum="56" Value="48"/>
                <TextBlock Grid.Column="2" Text="4800" Style="{StaticResource Readout}"
                           HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>

            <TextBlock Text="M E T E R S" Style="{StaticResource Sec}"/>
            <StackPanel Margin="0,0,0,8">
                <ProgressBar Style="{StaticResource Meter}" Value="72" Margin="0,0,0,10"/>
                <ProgressBar Style="{StaticResource Meter}" Value="41"
                             Foreground="{StaticResource Good}" Margin="0,0,0,10"/>
                <ProgressBar Style="{StaticResource Meter}" Value="93"
                             Foreground="{StaticResource Critical}"/>
            </StackPanel>

        </StackPanel>

        <!-- Right column -->
        <StackPanel Grid.Column="2">

            <TextBlock Text="S E R I E S   P A L E T T E" Style="{StaticResource Sec}" Margin="0,4,0,10"/>
            <Border Style="{StaticResource InsetSurface}" Padding="14" Margin="0,0,0,24">
                <StackPanel>
                    <UniformGrid Columns="8" Rows="1" Height="26">
                        <Border Background="{StaticResource Series1}" CornerRadius="3" Margin="0,0,3,0"/>
                        <Border Background="{StaticResource Series2}" CornerRadius="3" Margin="0,0,3,0"/>
                        <Border Background="{StaticResource Series3}" CornerRadius="3" Margin="0,0,3,0"/>
                        <Border Background="{StaticResource Series4}" CornerRadius="3" Margin="0,0,3,0"/>
                        <Border Background="{StaticResource Series5}" CornerRadius="3" Margin="0,0,3,0"/>
                        <Border Background="{StaticResource Series6}" CornerRadius="3" Margin="0,0,3,0"/>
                        <Border Background="{StaticResource Series7}" CornerRadius="3" Margin="0,0,3,0"/>
                        <Border Background="{StaticResource Series8}" CornerRadius="3"/>
                    </UniformGrid>
                    <TextBlock Text="assigned in order, never cycled" Style="{StaticResource Micro}"
                               Margin="0,8,0,0"/>
                    <UniformGrid Columns="4" Rows="1" Height="26" Margin="0,14,0,0">
                        <Border Background="{StaticResource Good}" CornerRadius="3" Margin="0,0,3,0"/>
                        <Border Background="{StaticResource Warning}" CornerRadius="3" Margin="0,0,3,0"/>
                        <Border Background="{StaticResource Serious}" CornerRadius="3" Margin="0,0,3,0"/>
                        <Border Background="{StaticResource Critical}" CornerRadius="3"/>
                    </UniformGrid>
                    <TextBlock Text="good · warning · serious · critical — reserved, never a series"
                               Style="{StaticResource Micro}" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <TextBlock Text="T Y P E   S C A L E" Style="{StaticResource Sec}"/>
            <StackPanel Margin="0,0,0,24">
                <TextBlock Text="68 °C" Style="{StaticResource Hero}"/>
                <TextBlock Text="StarMon" Style="{StaticResource Display}" Margin="0,2,0,0"/>
                <TextBlock Text="Fan control" Style="{StaticResource Title}" Margin="0,4,0,0"/>
                <TextBlock Text="The fan program runs while the window is closed."
                           Style="{StaticResource Body}" Margin="0,4,0,0"/>
                <TextBlock Text="C A P T I O N" Style="{StaticResource Caption}" Margin="0,6,0,0"/>
                <TextBlock Text="0123456789 · tabular readout" Style="{StaticResource Readout}"
                           Margin="0,6,0,0"/>
            </StackPanel>

            <TextBlock Text="T O G G L E S" Style="{StaticResource Sec}"/>
            <StackPanel Margin="0,0,0,24">
                <StackPanel Style="{StaticResource Row}" Margin="0,0,0,12">
                    <ToggleButton Style="{StaticResource Switch}" IsChecked="True" Margin="0,0,12,0"/>
                    <TextBlock Text="Automatic fan control" Style="{StaticResource Body}"
                               Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Style="{StaticResource Row}" Margin="0,0,0,14">
                    <ToggleButton Style="{StaticResource Switch}" Margin="0,0,12,0"/>
                    <TextBlock Text="Follow the power plan" Style="{StaticResource Body}"
                               Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                </StackPanel>
                <CheckBox Content="Start with Windows" Style="{StaticResource Check}"
                          IsChecked="True" Margin="0,0,0,10"/>
                <CheckBox Content="Write a log file" Style="{StaticResource Check}" Margin="0,0,0,10"/>
                <CheckBox Content="Unavailable on this model" Style="{StaticResource Check}"
                          IsEnabled="False"/>
            </StackPanel>

            <TextBlock Text="T E X T   E N T R Y" Style="{StaticResource Sec}"/>
            <StackPanel Margin="0,0,0,24">
                <TextBox Style="{StaticResource Field}" Text="Silent night" Margin="0,0,0,10"/>
                <TextBox Style="{StaticResource Field}" Text="Disabled" IsEnabled="False"/>
            </StackPanel>

            <!-- The instrument panel's own pieces. The two drawn ones are
                 placed into these hosts from the code-behind: markup cannot
                 name a type declared in this assembly. -->
            <TextBlock Text="I N S T R U M E N T   P A N E L" Style="{StaticResource Sec}"/>
            <Border Style="{StaticResource CardSurface}" Margin="0,0,0,24">
                <StackPanel Margin="14,12">

                    <!-- A figure with its trend beside it, which is the unit
                         the whole panel is built out of -->
                    <StackPanel Style="{StaticResource Row}">
                        <TextBlock Text="78.0" Style="{StaticResource ValueLarge}"/>
                        <TextBlock Text="°C" Style="{StaticResource Micro}"
                                   Margin="4,0,0,4" VerticalAlignment="Bottom"/>
                        <ContentControl x:Name="SparkLead" Width="96" Height="26"
                                        Margin="14,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>

                    <Border Style="{StaticResource Rule}" Margin="0,12,0,10"/>

                    <!-- The same element at row size, three colours, so the
                         set can be checked as a set -->
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="62"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Package power" Style="{StaticResource RowName}"/>
                        <ContentControl Grid.Column="1" x:Name="SparkRowA" Width="58" Height="16"
                                        Margin="0,0,12,0" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="46.2 W" Style="{StaticResource Readout}"
                                   HorizontalAlignment="Right"/>
                    </Grid>
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="62"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Graphics load" Style="{StaticResource RowName}"/>
                        <ContentControl Grid.Column="1" x:Name="SparkRowB" Width="58" Height="16"
                                        Margin="0,0,12,0" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="97 %" Style="{StaticResource Readout}"
                                   HorizontalAlignment="Right"/>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="62"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Chipset" Style="{StaticResource RowName}"/>
                        <ContentControl Grid.Column="1" x:Name="SparkRowC" Width="58" Height="16"
                                        Margin="0,0,12,0" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="62 °C" Style="{StaticResource Readout}"
                                   HorizontalAlignment="Right"/>
                    </Grid>

                    <Border Style="{StaticResource Rule}" Margin="0,12,0,12"/>

                    <!-- Per-core, twice: banded by health for temperatures,
                         one colour for clocks — there is no such thing as a
                         dangerous clock speed and colouring one red says so -->
                    <TextBlock Text="C O R E   ° C" Style="{StaticResource Micro}" Margin="0,0,0,6"/>
                    <ContentControl x:Name="BarsHealth" Height="34" Margin="0,0,0,12"/>
                    <TextBlock Text="C O R E   M H z" Style="{StaticResource Micro}" Margin="0,0,0,6"/>
                    <ContentControl x:Name="BarsFlat" Height="26"/>

                </StackPanel>
            </Border>

            <TextBlock Text="S T A T U S   B A D G E S" Style="{StaticResource Sec}"/>
            <StackPanel Style="{StaticResource Row}" Margin="0,0,0,24">
                <Border Style="{StaticResource Chip}" Margin="0,0,8,0">
                    <TextBlock Text="PROGRAM"/>
                </Border>
                <Border Style="{StaticResource ChipWarning}" Margin="0,0,8,0">
                    <TextBlock Text="THROTTLING"/>
                </Border>
                <Border Style="{StaticResource ChipAlert}">
                    <TextBlock Text="THERMAL PROTECTION"/>
                </Border>
            </StackPanel>

            <TextBlock Text="T A B S   ·   W I N D O W" Style="{StaticResource Sec}"/>
            <StackPanel Margin="0,0,0,10">
                <StackPanel Style="{StaticResource Row}" Height="34">
                    <ToggleButton Content="Dashboard" Style="{StaticResource TopTab}" IsChecked="True"/>
                    <ToggleButton Content="Sensors" Style="{StaticResource TopTab}"/>
                    <ToggleButton Content="Cooling" Style="{StaticResource TopTab}"/>
                    <ToggleButton Content="&#xE713;" Style="{StaticResource TopTabIcon}"/>
                </StackPanel>
                <Border Style="{StaticResource MicroSegmentGroup}"
                        HorizontalAlignment="Left" Margin="0,12,0,0">
                    <StackPanel Orientation="Horizontal">
                        <ToggleButton Content="2 min" Style="{StaticResource MicroSegment}" IsChecked="True"/>
                        <ToggleButton Content="5 min" Style="{StaticResource MicroSegment}"/>
                        <ToggleButton Content="10 min" Style="{StaticResource MicroSegment}"/>
                    </StackPanel>
                </Border>
            </StackPanel>

        </StackPanel>

    </Grid>
</UserControl>
