<?xml version="1.0"?>
<!-- StarMon: hardware monitoring and control
     Portions copyright © 2023-2024 Piotr Szczepański (GPL-3.0)

     This file only applies when it sits beside the executable as
     StarMon.exe.config. It is listed in the project as AppConfig, so the
     build puts it there; it used to be a plain None item, which meant it
     was never deployed and nothing in it did anything.

     It also used to carry a System.Windows.Forms.ApplicationConfigurationSection.
     The Windows Forms interface is gone and the project no longer references
     the assembly, so that block configured nothing at all. DPI awareness is
     declared in StarMon.manifest instead, which is where WPF reads it. -->
<configuration>
    <startup>
        <!-- The sku has to name the framework the project targets. It said
             v4.8.1 while StarMon.csproj targets v4.8. -->
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
    </startup>
</configuration>
