<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <!-- <AllowUnsafeBlocks>true</AllowUnsafeBlocks> -->
        <ApplicationIcon>Resources\Icon.ico</ApplicationIcon>
        <ApplicationManifest>StarMon.manifest</ApplicationManifest>
        <AssemblyName>StarMon</AssemblyName>
        <AssemblyVersionFile>All\Version.cs</AssemblyVersionFile>
        <Deterministic>true</Deterministic>
        <!-- With UseWPF the SDK quietly turns an Exe into a WinExe. build.ps1
             builds the test host as a console Exe, so that it can print its
             results and return an exit code to the shell that started it, and
             that has to survive. -->
        <DisableWinExeOutputInference>true</DisableWinExeOutputInference>
        <ErrorReport>prompt</ErrorReport>
        <OutputType>WinExe</OutputType>
        <Platforms>x64</Platforms>
        <PlatformTarget>x64</PlatformTarget>
        <!-- Has to match the identifier StarMon.sln uses for this project. The
             two disagreed, so the solution and the project were, as far as any
             tool reading both was concerned, describing different things. -->
        <ProjectGuid>{0FF1C1A1-DEC1-BE15-10AD-15C1A551F1ED}</ProjectGuid>
        <RootNamespace>StarMon</RootNamespace>
        <RuntimeIdentifier>win-x64</RuntimeIdentifier>
        <StartupObject>StarMon.App</StartupObject>
        <TargetFramework>net10.0-windows</TargetFramework>
        <UseWPF>true</UseWPF>
        <WarningLevel>4</WarningLevel>
    </PropertyGroup>
    <PropertyGroup>
        <!-- Where things go. The shipped program is the one file the publish
             step writes to Bin; the build output it is made from - the
             assembly, the host, the dependency and runtime manifests, the
             management libraries - is a means to that and stays under Obj,
             where it cannot be mistaken for something to hand out.

             The SDK would otherwise append the framework and the runtime
             identifier to all three paths, and Bin\StarMon.exe is where the
             README, the CI upload and every user's shortcut expect it. -->
        <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
        <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
        <IntermediateOutputPath>Obj\</IntermediateOutputPath>
        <OutputPath>Obj\Out\</OutputPath>
        <PublishDir>Bin\</PublishDir>
        <!-- One executable, as before: it needs the .NET 10 Desktop Runtime
             (x64) to be installed rather than carrying a copy of it. The
             management libraries the BIOS interface runs on include a native
             one, which a single file can only hold if it is allowed to unpack
             it at start-up; the rest are loaded straight from the bundle. -->
        <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
        <PublishSingleFile>true</PublishSingleFile>
        <SelfContained>false</SelfContained>
    </PropertyGroup>
    <PropertyGroup>
        <!-- All\Meta.cs and All\Version.cs carry the assembly's identity, as
             they did before the project was SDK-style, and the AddVersion
             target below stamps the version. The SDK would generate a second
             copy of each of those attributes, which does not compile; the ones
             it generates that nothing here declares - the target framework and
             the supported platform - are still wanted, so only the duplicates
             are switched off rather than the whole of GenerateAssemblyInfo. -->
        <GenerateAssemblyCompanyAttribute>false</GenerateAssemblyCompanyAttribute>
        <GenerateAssemblyConfigurationAttribute>false</GenerateAssemblyConfigurationAttribute>
        <GenerateAssemblyCopyrightAttribute>false</GenerateAssemblyCopyrightAttribute>
        <GenerateAssemblyDescriptionAttribute>false</GenerateAssemblyDescriptionAttribute>
        <GenerateAssemblyFileVersionAttribute>false</GenerateAssemblyFileVersionAttribute>
        <GenerateAssemblyInformationalVersionAttribute>false</GenerateAssemblyInformationalVersionAttribute>
        <GenerateAssemblyProductAttribute>false</GenerateAssemblyProductAttribute>
        <GenerateAssemblyTitleAttribute>false</GenerateAssemblyTitleAttribute>
        <GenerateAssemblyVersionAttribute>false</GenerateAssemblyVersionAttribute>
        <GenerateNeutralResourcesLanguageAttribute>false</GenerateNeutralResourcesLanguageAttribute>
    </PropertyGroup>
    <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
        <DebugSymbols>true</DebugSymbols>
        <DefineDebug>true</DefineDebug>
        <DebugType>full</DebugType>
        <Optimize>false</Optimize>
    </PropertyGroup>
    <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
        <DebugSymbols>false</DebugSymbols>
        <DebugType>none</DebugType>
        <Optimize>true</Optimize>
    </PropertyGroup>
    <PropertyGroup>
        <!-- The SDK picks up every .cs and .xaml under the project directory.
             That is the same set the old project listed by hand, but only once
             the directories that hold no sources are kept out of it: the
             build and publish output, and the knowledge graph the editor
             tooling writes beside the sources. Resources holds binaries that
             are embedded by name below and nothing the globs should touch. -->
        <DefaultItemExcludes>$(DefaultItemExcludes);Bin\**;Obj\**;graphify-out\**;Resources\**</DefaultItemExcludes>
    </PropertyGroup>
    <ItemGroup>
        <!-- The CIM client the BIOS interface runs on. It was part of Windows
             for .NET Framework; on .NET it is a package, which also brings the
             native half it calls into. -->
        <PackageReference Include="Microsoft.Management.Infrastructure" Version="3.0.0"/>
    </ItemGroup>
    <ItemGroup>
        <!-- StarMon.resx is gone with the Windows Forms interface that needed
             it. It held icons, bitmaps and a TrueType font, and the SDK's
             GenerateResource task — which runs on the core runtime — cannot
             serialize any of those.

             The application icon is still Resources\Icon.ico, through the
             ApplicationIcon property, which WPF also uses as the default
             window icon. Everything else the interface draws, it draws. -->
        <EmbeddedResource Include="Resources\Driver.sys.gz">
            <LogicalName>StarMon.Driver.sys.gz</LogicalName>
        </EmbeddedResource>
        <!-- The PawnIO modules: small verified programs handed to the signed
             PawnIO driver, which will only run ones it can verify. Carried
             here rather than fetched, so the application works on a machine
             that is offline and cannot pick up a module it did not ship with.
             Unmodified builds from the project's own signed release; see
             Resources\README.md. -->
        <EmbeddedResource Include="Resources\LpcACPIEC.bin">
            <LogicalName>StarMon.LpcACPIEC.bin</LogicalName>
        </EmbeddedResource>
        <EmbeddedResource Include="Resources\IntelMSR.bin">
            <LogicalName>StarMon.IntelMSR.bin</LogicalName>
        </EmbeddedResource>
        <EmbeddedResource Include="Resources\AMDFamily17.bin">
            <LogicalName>StarMon.AMDFamily17.bin</LogicalName>
        </EmbeddedResource>
    </ItemGroup>
    <!-- <ItemGroup>
        <ProjectReference Include="Driver.csproj">
            <Project>{10ADAB1E-11B1-ABE1-5ACC-E551B1EAB0DE}</Project>
            <Name>Driver</Name>
        </ProjectReference>
    </ItemGroup> -->
    <Target Name="AddVersion" BeforeTargets="CoreCompile" Condition="'$(AssemblyVersion)'!='' And '$(AssemblyVersionWord)'!=''">
        <Error
            Condition="'$([System.Text.RegularExpressions.Regex]::IsMatch(&quot;$(AssemblyVersion)&quot;, &quot;^\d+\.\d+\.\d+\.\d+$&quot;))' == false"
            Text="Assembly version must consist of exactly four non-negative integers separated by dots"/>
        <Message Text="Assembly Version: $(AssemblyVersion)-$(AssemblyVersionWord)" />
        <ReadLinesFromFile File="$(AssemblyVersionFile)">
            <Output TaskParameter="Lines" ItemName="AssemblyVersionLines" />
        </ReadLinesFromFile>
        <ItemGroup>
            <GeneratedVersionLines Include="@(AssemblyVersionLines)" Condition="'$([System.Text.RegularExpressions.Regex]::IsMatch(&quot;%(Identity)&quot;, &quot;(?i)Assembly((File|Informational)?Version|Metadata)&quot;))' == false" />
            <GeneratedVersionLines Include="[assembly: AssemblyVersion(&quot;$([System.Text.RegularExpressions.Regex]::Match($(AssemblyVersion), `\d+\.\d+\.\d+`))&quot;)]" />
            <GeneratedVersionLines Include="[assembly: AssemblyFileVersion(&quot;$(AssemblyVersion)&quot;)]" />
            <!-- Three components, not two. This matched \d+\.\d+, so every
                 build in a 1.0 line announced itself as "1.0-Release" however
                 far the patch number had moved — and the About page, the tray
                 menu and the command-line header all read this one, so there
                 was no way to tell 1.0.0 from 1.0.1 from inside the running
                 application. The file version kept the full number all along. -->
            <GeneratedVersionLines Include="[assembly: AssemblyInformationalVersion(&quot;$([System.Text.RegularExpressions.Regex]::Match($(AssemblyVersion), `\d+\.\d+\.\d+`))-$(AssemblyVersionWord)&quot;)]" />
            <GeneratedVersionLines Include="[assembly: AssemblyMetadata(&quot;Timestamp&quot;, &quot;$([System.DateTime]::Now.ToString('yyyy-MM-dd HH:mm'))&quot;)]" />
        </ItemGroup>
        <WriteLinesToFile File="$(IntermediateOutputPath)Version.cs" Lines="@(GeneratedVersionLines)" Overwrite="true" />
        <ItemGroup>
            <Compile Remove="$(AssemblyVersionFile)" />
            <Compile Include="$(IntermediateOutputPath)Version.cs" />
        </ItemGroup>
    </Target>
    <Target Name="BuildBeginning" BeforeTargets="BeforeBuild">
    </Target>
    <!-- Only seed the configuration when the output does not have one. This
         used to copy unconditionally, which overwrote the settings the running
         application had saved on every single build, so a value changed
         through the interface survived until the next rebuild and then
         silently reverted to the template's default. Pass
         /p:OverwriteConfig=true to refresh it deliberately.

         Both beside the build output, for a program started from there, and
         beside the published one, which is the one people run. -->
    <Target Name="BuildComplete" AfterTargets="AfterBuild">
        <Copy SourceFiles="StarMon.xml" DestinationFolder="$(OutDir)"
              Condition="!Exists('$(OutDir)StarMon.xml') Or '$(OverwriteConfig)' == 'true'" />
        <!-- <Exec Command="robocopy /nc /ndl /nfl /njh /njs /np /ns /r:2 /w:5 Bin \\Momentum\Exchange\ StarMon.*" IgnoreExitCode="true" /> -->
    </Target>
    <Target Name="PublishComplete" AfterTargets="Publish">
        <Copy SourceFiles="StarMon.xml" DestinationFolder="$(PublishDir)"
              Condition="!Exists('$(PublishDir)StarMon.xml') Or '$(OverwriteConfig)' == 'true'" />
    </Target>
    <Target Name="DeleteDirs" AfterTargets="Clean">
        <RemoveDir Directories="$(IntermediateOutputPath)" />
        <RemoveDir Directories="$(OutputPath)" />
        <RemoveDir Directories="$(PublishDir)" />
    </Target>
</Project>
