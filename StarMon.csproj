        <DisableWinExeOutputInference>true</DisableWinExeOutputInference>
        <ErrorReport>prompt</ErrorReport>
        <!-- Markup that names a type declared in this same assembly — the
             localisation extension, a binding converter — cannot be compiled
             in one pass: the compiler needs the assembly to resolve the type
             and the assembly needs the compiled markup. So it builds a
             throwaway assembly first, from a generated project, and that
             project tries to inherit the parent's NuGet restore output. There
             is none: this project has plain references and no PackageReference
             at all. Telling it not to look is the fix; there is nothing to
             find. -->
        <IncludePackageReferencesDuringMarkupCompilation>false</IncludePackageReferencesDuringMarkupCompilation>
